# Copia a .env en la raiz del proyecto y edita los valores.
# Para produccion con HTTPS, ver la seccion "Docker" del README.

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

# URLs publicas. Si usas el perfil https, pon https://tu-dominio aqui.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

# Solo con: docker compose --profile https up -d --build
FRONTEND_DOMAIN=
API_DOMAIN=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
